{
  "name": "slidetimedb",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "client:dev": "npm run dev -w client",
    "client:dev:prod": "npm run dev -w client -- --mode production",
    "client:build": "npm run build -w client",
    "db:start": "spacetime start",
    "db:publish": "spacetime publish slidetimedb --server local --module-path server",
    "db:publish:prod": "spacetime publish slidetimedb --server railway --module-path server",
    "db:generate": "spacetime generate --lang typescript --module-path server --out-dir client/src/module_bindings"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "client": "^0.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.1"
  },
  "packageManager": "npm@11.6.2"
}
